{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "cd authentic-reader-backend && npm install && npm start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": [
    {
      "name": "authentic-reader-backend",
      "source": ".",
      "buildCommand": "cd authentic-reader-backend && npm install",
      "startCommand": "cd authentic-reader-backend && npm start",
      "healthcheckPath": "/health",
      "environment": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "CORS_ORIGIN": "https://authentic-reader.netlify.app",
        "ENABLE_CHROMA": "false",
        "ENABLE_FEEDBACK_LOOP": "false"
      }
    },
    {
      "name": "llama-service",
      "source": "./llama-service",
      "buildCommand": "python -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
      "startCommand": "source venv/bin/activate && uvicorn src.main:app --host 0.0.0.0 --port 8080",
      "healthcheckPath": "/health",
      "environment": {
        "OLLAMA_HOST": "http://localhost:11434",
        "LLAMA_MODEL": "llama3:8b",
        "CACHE_SIZE": "1000",
        "CACHE_TTL": "3600"
      }
    },
    {
      "name": "nlp-service",
      "source": "./nlp-service",
      "buildCommand": "python -m venv venv && source venv/bin/activate && pip install -r requirements.txt && ./generate_onnx_models.sh",
      "startCommand": "source venv/bin/activate && uvicorn main:app --host 0.0.0.0 --port 8000",
      "healthcheckPath": "/health",
      "environment": {
        "USE_ONNX": "1",
        "ZERO_SHOT_MODEL": "facebook/bart-large-mnli",
        "NER_MODEL": "dslim/bert-base-NER"
      }
    }
  ]
}
