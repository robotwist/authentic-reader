# The deployed site reads these from Netlify environment variables (see README).
# For running the pipeline locally, copy to .env and fill in.

# Key for the analysis service
GROQ_API_KEY=

# Shared secret that protects the generation endpoint
BRIEFING_SECRET=

# Optional: current facts (such as who holds major offices) given to every reading
# CURRENT_CONTEXT=

# Optional: alternate storage name, used by preview deploys
# BRIEFINGS_STORE=

# Optional, front end only: point local development at another API origin
# VITE_API_URL=
