# Production Environment Variables for Authentic Reader

# API Configuration
# VITE_API_URL is unset so the app calls Netlify Functions on its own origin.

# Feature flags for production
VITE_ENABLE_CHROMA=false
VITE_ENABLE_FEEDBACK_LOOP=false
VITE_ENABLE_LOCAL_FALLBACKS=false

# Logging level for production
VITE_LOG_LEVEL=warn

# Disable development features
NODE_ENV=production
